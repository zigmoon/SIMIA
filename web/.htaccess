# SIMIA - application web installee (PWA)
#
# Apache ne connait pas les types ci-dessous par defaut : sans eux, le
# navigateur refuse le manifeste ou le service worker. A garder a la racine du
# dossier SIMIA, a cote de index.html.

<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
  AddType text/javascript .js .mjs
  AddType image/svg+xml .svg
  AddType application/json .json
  AddType image/png .png
</IfModule>

# Le service worker ne doit jamais etre servi depuis un cache intermediaire :
# sinon une ancienne version peut rester active pendant des heures.
<IfModule mod_headers.c>
  # L'interface doit pouvoir changer a chaque deploiement : le service worker
  # gere deja le hors-ligne, le cache HTTP n'a rien a garder ici.
  <FilesMatch "\.(html|css|js|mjs|webmanifest)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  # Regle du worker volontairement APRES la regle generique : Apache applique le
  # dernier FilesMatch correspondant, sinon le no-store serait ecrase.
  <FilesMatch "service-worker\.js$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Service-Worker-Allowed "/SIMIA/"
  </FilesMatch>
  # Seules les images et les polices peuvent rester en cache navigateur.
  <FilesMatch "\.(svg|png|ico|woff2)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>

# Compression : app.js fait pres de 400 Ko.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/manifest+json application/json image/svg+xml
</IfModule>

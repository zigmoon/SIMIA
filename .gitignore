# Binaires des moteurs : le CI les telecharge depuis les releases officielles,
# et les archives les embarquent. Rien a versionner.
vendor/

# Poids des modeles : plusieurs gigaoctets, servis par le CDN ou le serveur.
models/*.gguf
models/*.part
models/image/**/*.gguf
models/image/**/*.part
# VAE externe de Z-Image (310 Mo), place a la main.
models/image/*.safetensors
# Etat d'execution : dernier pack d'images choisi.
models/image/selected.json
# Poids annexes (TTS Kokoro, upscaler ESRGAN) : non references par le code.
models/tts/
models/upscale/
*.pth
*.onnx
*.ckpt

# Compilation Rust.
launcher/target/

# Dossier pret a televerser (tools/prepare-ftp.ps1) : ~3 Go, jamais versionne.
dist/

# Notes de release redigees par tools/release-body.mjs a chaque publication.
release-body.md

# Paquets compiles a telecharger depuis le site : des centaines de Mo, produits
# par tools/prepare-ftp.ps1 et non par Git.
deploy/downloads/*.zip
deploy/downloads/*.tar.gz
deploy/downloads/manifest.json

# Journaux et divers.
*.log
*.err
*.tmp
.DS_Store
Thumbs.db
desktop.ini

# Systeme.
.vscode/
.idea/
